# --- LLM (Mistral) ---
SRAG_LLM_PROVIDER=fake            # fake | mistral
SRAG_MISTRAL_API_KEY=
SRAG_LLM_MODEL=mistral-large-latest
SRAG_LLM_TEMPERATURE=0.1
SRAG_LLM_MAX_TOKENS=1024
SRAG_LLM_TIMEOUT_SECONDS=30        # outbound timeout to the LLM provider

# --- Embeddings ---
SRAG_EMBEDDING_PROVIDER=fake      # fake | mistral | local
SRAG_EMBEDDING_MODEL=mistral-embed
SRAG_EMBEDDING_DIM=1024
SRAG_EMBEDDING_TIMEOUT_SECONDS=30

# --- Vector store ---
SRAG_VECTOR_PROVIDER=memory       # memory | qdrant
SRAG_QDRANT_URL=http://localhost:6333
SRAG_QDRANT_COLLECTION=sovereign_rag
SRAG_QDRANT_TIMEOUT_SECONDS=10
SRAG_SPARSE_PROVIDER=fastembed     # none | fastembed (native sparse hybrid on Qdrant)
SRAG_SPARSE_MODEL=Qdrant/bm25

# --- Retrieval / chunking ---
SRAG_CHUNK_SIZE=800
SRAG_CHUNK_OVERLAP=120
SRAG_TOP_K=5
SRAG_MIN_SCORE=0.25

# --- Request limits (DoS / cost guardrails, enforced at the API layer) ---
SRAG_MAX_QUERY_CHARS=8000
SRAG_MAX_DOCUMENT_CHARS=200000
SRAG_MAX_DOCUMENTS_PER_REQUEST=256
SRAG_MAX_TOP_K=50

# --- Hybrid search / reranking ---
SRAG_RETRIEVAL_MODE=hybrid        # vector | hybrid
SRAG_CANDIDATE_K=20
SRAG_RRF_K=60
SRAG_RERANKER_PROVIDER=lexical    # none | lexical | cross_encoder
SRAG_RERANK_CANDIDATES=20
SRAG_CROSS_ENCODER_MODEL=BAAI/bge-reranker-base

# --- Access control (RBAC + multi-tenant) ---
SRAG_AUTH_ENABLED=false           # when false: single-tenant local admin
SRAG_AUTH_PROVIDER=static         # static (API keys) | oidc (JWT / OIDC)
SRAG_DEFAULT_TENANT=default
# JSON list of API-key principals (roles: admin | editor | viewer):
# SRAG_API_KEYS='[{"key":"acme-editor","subject":"alice","tenant_id":"acme","roles":["editor"]}]'
SRAG_API_KEYS=[]

# OIDC / JWT (used when SRAG_AUTH_PROVIDER=oidc; Bearer token in Authorization header):
SRAG_OIDC_ISSUER=                 # e.g. https://keycloak.example.eu/realms/acme
SRAG_OIDC_AUDIENCE=               # expected `aud` claim
SRAG_OIDC_JWKS_URL=               # optional; defaults to <issuer>/.well-known/jwks.json
SRAG_OIDC_JWKS_TIMEOUT_SECONDS=5  # timeout for fetching issuer JWKS
SRAG_OIDC_ALGORITHMS=RS256        # comma-separated; RS256 (JWKS) or HS256 (shared secret)
SRAG_OIDC_HS256_SECRET=           # only for HS256 (dev/testing)
SRAG_OIDC_SUBJECT_CLAIM=sub
SRAG_OIDC_TENANT_CLAIM=tenant_id  # falls back to SRAG_DEFAULT_TENANT when absent
SRAG_OIDC_ROLES_CLAIM=roles       # list claim mapped onto admin|editor|viewer

# --- Compliance / sovereignty ---
SRAG_ALLOWED_REGIONS=eu-west,eu-central
SRAG_DEFAULT_REGION=eu-west
SRAG_PII_POLICY=mask              # mask | refuse | allow
# Hash-chained audit log. Use `postgres` for multi-replica HA (shared chain);
# `file` is node-local and only consistent for a single instance.
SRAG_AUDIT_PROVIDER=file          # file | postgres
SRAG_AUDIT_PATH=data/audit/audit.log
SRAG_AUDIT_DSN=                   # required when SRAG_AUDIT_PROVIDER=postgres

# Reversible PII vault: tokenize PII at ingestion (instead of destructive masking)
# and detokenize answers for authorized principals. Tokens are deterministic and
# values are encrypted at rest; set a strong secret in production.
SRAG_PII_VAULT_ON_INGEST=false
SRAG_PII_VAULT_SECRET=

# --- Fine-tuning (LoRA) ---
SRAG_FINE_TUNING_PROVIDER=fake    # none | fake | mistral | local
SRAG_FINE_TUNING_BASE_MODEL=open-mistral-7b   # HF id (e.g. mistralai/Mistral-7B-Instruct-v0.3) for local
SRAG_FINE_TUNING_EPOCHS=3
SRAG_FINE_TUNING_LEARNING_RATE=0.0001
SRAG_FINE_TUNING_SUFFIX=sovereign
SRAG_FINE_TUNING_MIN_EXAMPLES=10
SRAG_FINE_TUNING_OUTPUT_DIR=data/fine_tuning

# --- Observability ---
SRAG_LANGFUSE_ENABLED=false
SRAG_LANGFUSE_HOST=http://localhost:3000
SRAG_LANGFUSE_PUBLIC_KEY=
SRAG_LANGFUSE_SECRET_KEY=
